{
    "name": "appnave/nave-vendas-sp",
    "description": "Pacote Laravel para sincronização e importação de dados do SP via RabbitMQ.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "BildVitta\\SpVendas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BildVitta\\SpVendas\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.0|^8.1",
        "appnave/nave-sdk-iss": "^0.2",
        "appnave/nave-crm-sp": "^0.2",
        "appnave/nave-hub-sp": "^0.2",
        "appnave/nave-produto-sp": "^0.2",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "php-amqplib/php-amqplib": "^3.2.0",
        "spatie/laravel-package-tools": "^1.12"
    },
    "require-dev": {
        "brianium/paratest": "^6.6",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^6.2",
        "orchestra/testbench": "^7.6",
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "BildVitta\\SpVendas\\SpVendasServiceProvider"
            ],
            "aliases": {
                "SpVendas": "BildVitta\\SpVendas\\SpVendasFacade"
            }
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "scripts": {
        "test": "./vendor/bin/testbench package:test --parallel --no-coverage",
        "test-coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html coverage",
        "check-style": [
            "vendor/bin/pint --test"
        ],
        "fix-style": [
            "vendor/bin/pint"
        ]
    }
}